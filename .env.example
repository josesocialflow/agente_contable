# Plantilla de configuración del agente de cuentas por pagar.
#
# Copiar a `.env` (en la raíz del repositorio o en esta misma carpeta) y
# completar los valores. El `.env` real NO se sube al repositorio: lleva
# credenciales.
#
# Todas las variables del agente usan el prefijo AGENTE_. Las líneas
# comentadas son los valores por defecto: solo hace falta descomentarlas para
# cambiarlos.

# --- Modelo de lenguaje (obligatorio) -------------------------------------
OPENAI_API_KEY=sk-...

# AGENTE_MODELO=gpt-4o-mini
# AGENTE_TEMPERATURA=0
# AGENTE_REINTENTOS_EXTRACCION=2

# --- Reglas de negocio ----------------------------------------------------
# Por encima de este importe la factura va a revisión aunque no tenga
# ninguna incidencia documental.
# AGENTE_UMBRAL_APROBACION=1000
# AGENTE_DIAS_VENCIMIENTO_POR_DEFECTO=30

# --- Avisos ---------------------------------------------------------------
# 'consola' imprime el aviso por pantalla: no necesita credenciales y permite
# probar el proyecto recién clonado.
AGENTE_NOTIFICADOR=consola

# Para usar Telegram:
#   1. En Telegram, hablar con @BotFather y enviar /newbot.
#   2. Copiar el token que devuelve.
#   3. Abrir el chat del bot y pulsar Start (un bot no puede escribir primero).
#   4. Pedir el chat_id:  curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates"
#      y quedarse con result[0].message.chat.id.
#   5. Poner AGENTE_NOTIFICADOR=telegram y descomentar las dos líneas.
# AGENTE_TELEGRAM_TOKEN=1234567890:AAH...
# AGENTE_TELEGRAM_CHAT_ID=987654321

# --- Coste de extracción (dólares por millón de tokens) -------------------
# Tarifa pública de gpt-4o-mini. Se usa para estimar el coste de extracción
# que muestra el panel; si cambia el precio, se cambia aquí.
# AGENTE_PRECIO_ENTRADA_POR_MILLON=0.15
# AGENTE_PRECIO_SALIDA_POR_MILLON=0.60

# --- Panel y vigilancia ---------------------------------------------------
# AGENTE_AUTO_REFRESCO_SEGUNDOS=3
# AGENTE_INTERVALO_VIGILANCIA=2
